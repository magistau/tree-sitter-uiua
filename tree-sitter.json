{
	"$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
	"grammars": [
		{
			"name": "uiua",
			"camelcase": "Uiua",
			"title": "Uiua",
			"scope": "source.uiua",
			"file-types": [
				"uiua",
				"ua"
			],
			"injection-regex": "^uiua$",
			"class-name": "TreeSitterUiua"
		}
	],
	"metadata": {
		"version": "0.1.0",
		"license": "BSD-3-Clause",
		"description": "A stack-based array programming language",
		"authors": [
			{
				"name": "Tau",
				"email": "tree-sitter@alice-carroll.pet"
			}
		],
		"links": {
			"repository": "https://github.com/magistau/tree-sitter-uiua"
		}
	},
	"bindings": {
		"c": true,
		"go": true,
		"node": true,
		"python": true,
		"rust": true,
		"swift": true,
		"zig": false
	}
}
